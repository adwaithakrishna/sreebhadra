# ---- Server ----
PORT=5000
NODE_ENV=development
# Origin(s) allowed to call the API from a browser (comma separated). Not needed when the
# built client is served by Express (same origin).
CLIENT_ORIGIN=http://localhost:5173
# IANA timezone of the business; decides what "today" and "past time" mean for bookings.
BUSINESS_TIMEZONE=Asia/Kolkata

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/wayfarer
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/wayfarer?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://adwaithakku6822_db_user:adwaithakku6822_db_user@sbweb.fbmxza5.mongodb.net/

# ---- Admin auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
# Used only by `npm run seed` to create the first admin. Change the password immediately.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=admin@1234

# ---- Image storage ----
# local = files saved in server/uploads (fine for dev / single server with a persistent disk)
# cloudinary = hosted storage (recommended for production)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Public base URL for local uploads (leave empty to use relative /uploads/... URLs)
PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
